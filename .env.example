# Set only when the public launch URL and catalogue are approved.
# NEXT_PUBLIC_SITE_URL=https://your-approved-domain.be

# Stripe secret key (server-only). Use sk_test_... until launch, then sk_live_...
# Without it, checkout returns "Betalen is nog niet actief".
# STRIPE_SECRET_KEY=sk_test_...

# Signing secret of the Stripe webhook pointing at /api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded).
# Needed to lower stock automatically after a paid order.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Password for /admin. Use a long random value.
# ADMIN_PASSWORD=...
